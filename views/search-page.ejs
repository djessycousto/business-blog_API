<%- include('./partials/header.ejs') %>

    <style>
        body {
            visibility: hidden;
        }

        body.fonts-loaded {
            visibility: visible;
        }

        .searcch-wrap {
            min-height: 300px;
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }





        .grid_card {
            width: 100%;
            /* Or a max-width if you want to limit the content */
            max-width: 800px;
            /* Example limit */
        }

        .grid_card-text {
            /* width: 600px; */
            width: 100%;
        }

        .grid_card-text p {
            white-space: normal;
            width: 100%;
            /* Ensures text wraps */
            word-wrap: break-word;
            /* Breaks long words if needed */
            overflow-wrap: break-word;
            /* Ensures consistent wrapping */
            /* max-width: 400px; */
            /* Limits text width to stay within the container */
        }







        /* .grid_card-text p { */
