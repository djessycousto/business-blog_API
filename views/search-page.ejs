        }


        main {
            border: 1px solid red;
        }


        .grid_card-text p {
            white-space: normal;
            border: 1px solid red;
            width: 100%;
            /* Ensures text wraps */
            word-wrap: break-word;
            /* Breaks long words if needed */
            overflow-wrap: break-word;
            /* Ensures consistent wrapping */
            max-width: 100%;
            /* Limits text width to stay within the container */
        }

        .grid_card-img {
